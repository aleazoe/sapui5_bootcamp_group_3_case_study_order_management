<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<edmx:Edmx Version="1.0" xmlns:edmx="http://schemas.microsoft.com/ado/2007/06/edmx" xmlns:sap="http://www.sap.com/Protocols/SAPData">
    <edmx:DataServices xmlns:m="http://schemas.microsoft.com/ado/2007/08/dataservices/metadata" m:DataServiceVersion="2.0">
        <Schema xmlns="http://schemas.microsoft.com/ado/2008/09/edm" Namespace="ProjectModel">
            <EntityType Name="Order">
                <Key>
                    <PropertyRef Name="OrderID" />
                </Key>
                <Property Name="OrderID" Type="Edm.String" Nullable="false" MaxLength="6" FixedLength="true" sap:label="Order Number" />
                <Property Name="CreationDate" Type="Edm.Date" Precision="3" sap:label="Creation Date" />
                <Property Name="ReceivingPlantID" Type="Edm.Int32" Nullable="false" MaxLength="4" FixedLength="true" sap:label="Receiving Plant" />
                <Property Name="DeliveringPlantID" Type="Edm.Int32" Nullable="false" MaxLength="4" FixedLength="true" sap:label="Delivering Plant" />
                <Property Name="Status" Type="Edm.String" Nullable="false" sap:label="Status" />
                <NavigationProperty Name="ToOrderDetails" Relationship="ProjectModel.Order_OrderDetails" FromRole="Order" ToRole="OrderDetail" />
                <NavigationProperty Name="ToReceivingPlant" Relationship="ProjectModel.ReceivingPlantName" FromRole="Order" ToRole="ReceivingPlant" />
                <NavigationProperty Name="ToDeliveringPlant" Relationship="ProjectModel.DeliveringPlantName" FromRole="Order" ToRole="DeliveringPlant" />
                <NavigationProperty Name="ToProducts" Relationship="ProjectModel.Order_Products" FromRole="Order" ToRole="Product" />
            </EntityType>
            <EntityType Name="OrderDetail">
                <Key>
                    <PropertyRef Name="OrderID" />
                    <PropertyRef Name="ProductID" />
                </Key>
                <Property Name="OrderID" Type="Edm.String" Nullable="false" MaxLength="6" FixedLength="true" sap:label="Order Number" />
                <Property Name="ProductID" Type="Edm.String" Nullable="false" sap:label="Product ID" />
                <Property Name="Quantity" Type="Edm.Int16" Nullable="false" sap:label="Quantity" />
                <Property Name="UnitPrice" Type="Edm.Decimal" Nullable="false" Precision="19" Scale="4" sap:label="Unit Price" />
                <NavigationProperty Name="ToOrder" Relationship="ProjectModel.Order_OrderDetails" FromRole="OrderDetail" ToRole="Order" />
                <NavigationProperty Name="ToProduct" Relationship="ProjectModel.Product_OrderDetails" FromRole="OrderDetail" ToRole="Product" />
            </EntityType>
            <EntityType Name="Product">
                <Key>
                    <PropertyRef Name="ProductID" />
                    <PropertyRef Name="DeliveringPlantID" />
                </Key>
                <Property Name="ProductID" Type="Edm.String" Nullable="false" sap:label="Product ID" />
                <Property Name="ProductName" Type="Edm.String" Nullable="false" sap:label="Product Name" />
                <Property Name="DeliveringPlantID" Type="Edm.Int32" Nullable="false" MaxLength="4" FixedLength="true" sap:label="Delivering Plant" />
                <Property Name="UnitPrice" Type="Edm.Decimal" Nullable="false" Precision="19" Scale="4" sap:label="Unit Price" />
                <NavigationProperty Name="ToPlant" Relationship="ProjectModel.DeliveringPlant_Products" FromRole="Product" ToRole="Plant" />
                <NavigationProperty Name="ToOrderDetails" Relationship="ProjectModel.Product_OrderDetails" FromRole="Product" ToRole="OrderDetail" />
                <NavigationProperty Name="ToOrder" Relationship="ProjectModel.Order_Products" FromRole="Product" ToRole="Order" />
            </EntityType>
            <EntityType Name="Plant">
                <Key>
                    <PropertyRef Name="PlantID" />
                </Key>
                <Property Name="PlantID" Type="Edm.Int32" Nullable="false" MaxLength="4" FixedLength="true" sap:label="Plant Code" />
                <Property Name="PlantName" Type="Edm.String" Nullable="false" sap:label="Description" />
                <NavigationProperty Name="ToReceivingOrders" Relationship="ProjectModel.ReceivingPlantName" FromRole="ReceivingPlant" ToRole="Order" />
                <NavigationProperty Name="ToDeliveringOrders" Relationship="ProjectModel.DeliveringPlantName" FromRole="DeliveringPlant" ToRole="Order" />
                <NavigationProperty Name="ToProducts" Relationship="ProjectModel.DeliveringPlant_Products" FromRole="Plant" ToRole="Product" />
            </EntityType>
            <Association Name="Order_OrderDetails">
                <End Type="ProjectModel.Order" Role="Order" Multiplicity="1" />
                <End Type="ProjectModel.OrderDetail" Role="OrderDetail" Multiplicity="*" />
                <ReferentialConstraint>
                    <Principal Role="Order">
                        <PropertyRef Name="OrderID" />
                    </Principal>
                    <Dependent Role="OrderDetail">
                        <PropertyRef Name="OrderID" />
                    </Dependent>
                </ReferentialConstraint>
            </Association>
            <Association Name="ReceivingPlantName">
                <End Type="ProjectModel.Plant" Role="ReceivingPlant" Multiplicity="1" />
                <End Type="ProjectModel.Order" Role="Order" Multiplicity="*" />
                <ReferentialConstraint>
                    <Principal Role="ReceivingPlant">
                        <PropertyRef Name="PlantID" />
                    </Principal>
                    <Dependent Role="Order">
                        <PropertyRef Name="ReceivingPlantID" />
                    </Dependent>
                </ReferentialConstraint>
            </Association>
            <Association Name="DeliveringPlantName">
                <End Type="ProjectModel.Plant" Role="DeliveringPlant" Multiplicity="1" />
                <End Type="ProjectModel.Order" Role="Order" Multiplicity="*" />
                <ReferentialConstraint>
                    <Principal Role="DeliveringPlant">
                        <PropertyRef Name="PlantID" />
                    </Principal>
                    <Dependent Role="Order">
                        <PropertyRef Name="DeliveringPlantID" />
                    </Dependent>
                </ReferentialConstraint>
            </Association>
            <Association Name="Product_OrderDetails">
                <End Type="ProjectModel.Product" Role="Product" Multiplicity="1" />
                <End Type="ProjectModel.OrderDetail" Role="OrderDetail" Multiplicity="*" />
                <ReferentialConstraint>
                    <Principal Role="Product">
                        <PropertyRef Name="ProductID" />
                    </Principal>
                    <Dependent Role="OrderDetail">
                        <PropertyRef Name="ProductID" />
                    </Dependent>
                </ReferentialConstraint>
            </Association>
            <Association Name="DeliveringPlant_Products">
                <End Type="ProjectModel.Plant" Role="Plant" Multiplicity="1" />
                <End Type="ProjectModel.Product" Role="Product" Multiplicity="*" />
                <ReferentialConstraint>
                    <Principal Role="Plant">
                        <PropertyRef Name="PlantID" />
                    </Principal>
                    <Dependent Role="Product">
                        <PropertyRef Name="DeliveringPlantID" />
                    </Dependent>
                </ReferentialConstraint>
            </Association>
            <Association Name="Order_Products">
                <End Type="ProjectModel.Order" Role="Order" Multiplicity="1" />
                <End Type="ProjectModel.Product" Role="Product" Multiplicity="*" />
                <ReferentialConstraint>
                    <Principal Role="Order">
                        <PropertyRef Name="DeliveringPlantID" />
                    </Principal>
                    <Dependent Role="Product">
                        <PropertyRef Name="DeliveringPlantID" />
                    </Dependent>
                </ReferentialConstraint>
            </Association>
            <EntityContainer Name="ProjectEntities" m:IsDefaultEntityContainer="true">
                <EntitySet Name="Orders" EntityType="ProjectModel.Order" />
                <EntitySet Name="OrderDetails" EntityType="ProjectModel.OrderDetail" />
                <EntitySet Name="Products" EntityType="ProjectModel.Product" />
                <EntitySet Name="Plants" EntityType="ProjectModel.Plant" />
                <AssociationSet Name="Order_OrderDetailsSet" Association="ProjectModel.Order_OrderDetails">
                    <End Role="Order" EntitySet="Orders" />
                    <End Role="OrderDetail" EntitySet="OrderDetails" />
                </AssociationSet>
                <AssociationSet Name="ReceivingPlantNameSet" Association="ProjectModel.ReceivingPlantName">
                    <End Role="ReceivingPlant" EntitySet="Plants" />
                    <End Role="Order" EntitySet="Orders" />
                </AssociationSet>
                <AssociationSet Name="DeliveringPlantNameSet" Association="ProjectModel.DeliveringPlantName">
                    <End Role="DeliveringPlant" EntitySet="Plants" />
                    <End Role="Order" EntitySet="Orders" />
                </AssociationSet>
                <AssociationSet Name="Product_OrderDetailsSet" Association="ProjectModel.Product_OrderDetails">
                    <End Role="Product" EntitySet="Products" />
                    <End Role="OrderDetail" EntitySet="OrderDetails" />
                </AssociationSet>
                <AssociationSet Name="DeliveringPlant_ProductsSet" Association="ProjectModel.DeliveringPlant_Products">
                    <End Role="Plant" EntitySet="Plants" />
                    <End Role="Product" EntitySet="Products" />
                </AssociationSet>
                <AssociationSet Name="Order_ProductsSet" Association="ProjectModel.Order_Products">
                    <End Role="Order" EntitySet="Orders" />
                    <End Role="Product" EntitySet="Products" />
                </AssociationSet>
            </EntityContainer>
        </Schema>
    </edmx:DataServices>
</edmx:Edmx>