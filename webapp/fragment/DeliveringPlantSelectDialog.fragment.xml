<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <SelectDialog
        id="idDeliveringPlantDialog"
        title="Select Delivering Plant"
        items="{plants>/deliveringPlants}"
        search="onSearchDeliveringPlant"
        confirm="onConfirmDeliveringPlant"
        cancel="onCancelPlantDialog"
        noDataText="No data">
        <StandardListItem id="IDStandardListItem"
            title="{plants>name}"
            description="{plants>code}"
            type="Active" />
    </SelectDialog>
</core:FragmentDefinition>