<mvc:View
    controllerName="sapips.training.ordermanagement.controller.OrderMainView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
>
    <f:DynamicPage
        id="orderDynamicPageId"
        preserveHeaderStateOnScroll="false"
        headerExpanded="true"
        toggleHeaderOnTitleClick="false"
        showFooter="false"
        fitContent="true"
    >
        <f:header>
            <f:DynamicPageHeader id="orderPageHeaderId" pinnable="true">
                <layout:HorizontalLayout allowWrapping="true">
						<layout:VerticalLayout class="sapUiMediumMarginEnd">
                            <Label text="Order Number"/>
                            <Input id="inputOrderID" value="test" />
						</layout:VerticalLayout>

						<layout:VerticalLayout>
							<Label text="Creation Date"/>
                            <Input id="inputCreationDate" value="test" />
						</layout:VerticalLayout>

                        <layout:VerticalLayout>
							<Label text="Status"/>
                            <Input id="inputStatus" value="test" />
						</layout:VerticalLayout>

                        <Button id="goButton" text="Go" />
                        <Button id="clearButton" text="Clear" />
					</layout:HorizontalLayout>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <Table
                id="orderTable"
                items="{
                path: '/Orders',
                parameters: {
                    expand: 'ToReceivingPlant,ToDeliveringPlant'
                    }
                }"
                mode="SingleSelectMaster"
                itemPress=".onPressOrderItem"
            >
                <headerToolbar>
                    <OverflowToolbar id="otbTableTitle">
                        <Title id="tableTitleId" text="Orders" level="H2" />
                        <ToolbarSpacer />
                        <Button id="createButton" icon="sap-icon://add" press="onPressCreateBtn" />
                        <Button id="deleteButton" icon="sap-icon://delete" press="onPressDeleteBtn" />
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column id="orderIDCol">
                        <Text id="orderIDColText" text="Order Number" />
                    </Column>
                    <Column id="creationDateCol">
                        <Text id="creationDateColText" text="Creation Date" />
                    </Column>
                    <Column id="receivingPlantCol">
                        <Text id="receivingPlantColText" text="Receiving Plant" />
                    </Column>
                    <Column id="deliveringCol">
                        <Text id="deliveringColText" text="Delivering Plant" />
                    </Column>
                    <Column id="statusCol">
                        <Text id="statusColText" text="Status" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem id="orderItems" type="Active">
                        <cells>
                            <Text id="orderIdVal" text="{OrderID}" />
                            <Text id="creationDateVal" 
                                text="{
                                        path: 'CreationDate',
                                        type: 'sap.ui.model.type.Date',
                                        formatOptions: { 
                                            source: { pattern: 'yyyy-MM-dd' },
                                            pattern: 'dd MMM yyyy' }
                                    }" />
                            <Text id="receivingPlantVal" text="{ReceivingPlantID} - {ToReceivingPlant/PlantName}" />
                            <Text id="deliveringPlantVal" text="{DeliveringPlantID} - {ToDeliveringPlant/PlantName}" />
                            <Text id="statusVal" text="{Status}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>
