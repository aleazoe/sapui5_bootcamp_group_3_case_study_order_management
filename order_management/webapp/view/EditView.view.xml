<mvc:View
    controllerName="sapips.training.ordermanagement.controller.EditView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <f:DynamicPage
        id="editDynamicPageId"
        preserveHeaderStateOnScroll="true"
        headerExpanded="true"
        showFooter="true"
        fitContent="true"
    >
        <!-- Dynamic Page Title -->
        <f:title>
            <f:DynamicPageTitle id="editPageTitle">
                <f:heading>
                    <Title
                        id="editPageTitleText"
                        text="Edit Order"
                    />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:content>
            <VBox>
                <core:Fragment fragmentName="sapips.training.ordermanagement.fragment.OrderDetail" type="XML" />
                <core:Fragment fragmentName="sapips.training.ordermanagement.fragment.OrderProducts" type="XML" />
            </VBox>
        </f:content>
        
        <f:footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button id="saveEditButton" type="Emphasized" text="Save" press=".onPressSaveEdit" />
                <Button id="cancelEditButton" type="Reject" text="Cancel" press=".onPressCancelEdit" />
            </OverflowToolbar>
        </f:footer>
    </f:DynamicPage>
</mvc:View>
