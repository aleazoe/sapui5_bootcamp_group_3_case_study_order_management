{
  "_version": "1.81.0",
  "sap.app": {
    "id": "sapips.training.ordermanagement",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.20.2",
      "toolsId": "0456d5c2-42b8-4afe-83e4-8d0455e6b4a7"
    },
    "dataSources": {
      "mainService": {
        "uri": "/here/goes/your/serviceurl/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.144.1",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "sapips.training.ordermanagement.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "useBatch": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "sapips.training.ordermanagement.view",
        "async": true,
        "viewPath": "sapips.training.ordermanagement.view"
      },
      "routes": [
        {
          "name": "RouteOrderMainView",
          "pattern": ":?query:",
          "target": [
            "TargetOrderMainView"
          ]
        },
        {
          "name": "RouteDetailPage",
          "pattern": "Detail/{orderID}",
          "target": [
            "TargetDetailPage"
          ]
        },
        {
          "name": "RouteEditPage",
          "pattern": "Edit/{orderID}",
          "target": [
            "TargetEditPage"
          ]
        }
      ],
      "targets": {
        "TargetOrderMainView": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "OrderMainView",
          "viewName": "OrderMainView"
        },
        "TargetDetailPage": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "DetailView",
          "viewName": "DetailView"
        },
        "TargetEditPage": {
          "viewId": "EditView",
          "viewName": "EditView"
        }
      }
    },
    "rootView": {
      "viewName": "sapips.training.ordermanagement.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
