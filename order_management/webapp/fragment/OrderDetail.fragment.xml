<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
   <VBox class="sapUiSmallMargin">
        <f:SimpleForm
            id="orderDetailForm"
            editable="false"
            layout="ResponsiveGridLayout"
            title="Order Detail"
            labelSpanXL="4"
            labelSpanL="3"
            labelSpanM="4"
            labelSpanS="12"
            adjustLabelSpan="false"
            emptySpanXL="0"
            emptySpanL="4"
            emptySpanM="0"
            emptySpanS="0"
            columnsXL="2"
            columnsL="1"
            columnsM="1"
            singleContainerFullSize="false"
        >
            <f:content>
                <Label text="Order Number" />
                <Text
                    id="nameText"
                    text="{OrderID}"
                />

                <Label text="Creation Date" />
                <Text id="creationDateVal" 
                    text="{
                            path: 'CreationDate',
                            type: 'sap.ui.model.type.Date',
                            formatOptions: { 
                                source: { pattern: 'yyyy-MM-dd' },
                                pattern: 'dd MMM yyyy' }
                        }" />

                <Label text="Receiving Plant" />
                <Text text="{ReceivingPlantID} - {ToReceivingPlant/PlantName}" />

                <Label text="Receiving Plant" />
                <Text text="{DeliveringPlantID} - {ToDeliveringPlant/PlantName}" />

                <Label text="Status" />
                <Text text="{Status}" />
            </f:content>
        </f:SimpleForm>
    </VBox>
</core:FragmentDefinition>
