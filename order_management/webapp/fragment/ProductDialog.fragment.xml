<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<SelectDialog
		id="productDialogId"
		noDataText="No Products Found"
		title="Select Product"
		search=".onSearchProduct"
		confirm=".onProductDialogConfirm"
		cancel=".onDialogClose"
		items="{
			path: '/Products',
            sorter: {
                path: 'ProductName'
            }
		}">
		<StandardListItem id="productList"
			title="{ProductName}"
			description="{ProductID}"
			iconDensityAware="false"
			iconInset="false"
			type="Active" />
	</SelectDialog>
</core:FragmentDefinition>